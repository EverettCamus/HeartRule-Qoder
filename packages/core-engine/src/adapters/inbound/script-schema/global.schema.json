{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "global.schema.json",
  "title": "Global Variables Schema",
  "description": "global.yaml 全局变量定义文件的 Schema 验证",
  "type": "object",
  "required": ["variables"],
  "properties": {
    "variables": {
      "type": "array",
      "minItems": 1,
      "description": "全局变量列表",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "变量名称（必填），用于在脚本中引用该变量"
          },
          "define": {
            "type": "string",
            "description": "变量说明，描述该变量的含义和获取方式"
          },
          "defaultValue": {
            "description": "变量的默认值，在用户未提供时使用"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
