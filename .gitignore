# TypeScript迁移项目 - 新增忽略规则

# 构建输出
/packages/*/dist/
/packages/*/build/
*.tsbuildinfo

# TypeScript缓存
*.tsbuildinfo

# pnpm
.pnpm-store/
.pnpm-debug.log
node_modules

# 测试覆盖率
coverage/
.nyc_output/

# Playwright E2E 测试
packages/script-editor/e2e/playwright-report/
packages/script-editor/e2e/test-results/
# Playwright 也会把 test-results/ 落在包根（非 e2e）——曾因此漏掉 2 个文件入库
packages/*/test-results/
packages/api-server/test-project-id.txt
.playwright/

# 测试命令的输出残留（曾入库 7 个：api-server 3 · core-engine 1 · script-editor 3）
packages/*/test-output.*
packages/*/test-result.*

# 数据库备份（数据文件不入库；说明文档入库）
backups/
!backups/README.md

# 环境变量
.env
.env.local
.env.*.local

# 临时文件
*.tmp
*.temp

# 测试用 JSON 文件
packages/api-server/test-*.json

# 工程工作空间（运行时数据）
packages/api-server/workspace/
workspace/projects/

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json

# Husky
.husky/_

# ========================================
# Legacy Python (待弃用)
# ========================================

# Python虚拟环境
legacy-python/venv/
legacy-python/.venv/
legacy-python/env/
legacy-python/ENV/

# Python字节码
legacy-python/__pycache__/
legacy-python/**/*.pyc
legacy-python/**/*.pyo
legacy-python/**/*.pyd

# Python测试缓存
legacy-python/.pytest_cache/
legacy-python/.coverage
legacy-python/htmlcov/

# Python IDE
legacy-python/.idea/
legacy-python/*.swp
legacy-python/*.swo

# Python数据
legacy-python/data/*.db
legacy-python/data/*.sqlite

# Git Worktrees
.worktrees/
worktrees/

# Claude Code / OpenCode 本地工具状态
.opencode/
.claude/worktrees/
.claude/settings.local.json

# Sisyphus agent working files
.sisyphus/
