# 开发环境变量模板
# 复制此文件为 .env 并填写实际值

# Node环境
NODE_ENV=development

# 数据库配置
DATABASE_URL=postgresql://heartrule:heartrule_dev_2024@localhost:5432/heartrule_ai

# Redis配置
REDIS_URL=redis://:heartrule_redis_2024@localhost:6379

# LLM配置
# 可选值: openai | deepseek | volcano (默认)
LLM_PROVIDER=volcano

# OpenAI配置（LLM_PROVIDER=openai 时使用）
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# DeepSeek官方API配置（LLM_PROVIDER=deepseek 时使用）
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 火山引擎配置（LLM_PROVIDER=volcano 时使用，默认）
VOLCANO_API_KEY=your_volcano_api_key_here
VOLCANO_ENDPOINT_ID=your_endpoint_id_here
VOLCANO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# API服务配置
API_PORT=8000
API_HOST=0.0.0.0

# JWT密钥（生产环境务必修改）
JWT_SECRET=your_jwt_secret_change_in_production

# 日志级别

# 工程工作区路径（存储工程模板文件）
PROJECTS_WORKSPACE=./workspace/projects
